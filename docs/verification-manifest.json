   "profiles": [
    "check",
    "ci"
   ],
   "needs": [
    "critical-router-selection",
    "critical-router-policy-call-limit",
    "critical-gemini-timeout",
    "critical-app-builder-recovery"
   ],
   "timeoutMs": 150000,
   "critical": true,
   "phase": "minimum-suite"
  },
  {
   "id": "test:project",
   "argv": [
    "npm",
    "run",
    "test:project"
   ],
   "profiles": [
    "check",
    "ci"
   ],
   "needs": [
    "critical-router-selection",
