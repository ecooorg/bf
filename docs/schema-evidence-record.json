{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biforge.local/schemas/schema-evidence-record.json",
  "title": "Evidence Record",
  "description": "One or more evidence items with mandatory provenance. Critical missing provenance must not be reported as PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "status",
    "items"
  ],
  "properties": {
    "meta": {
      "$ref": "schema-common.json#/$defs/schemaMeta"
    },
    "status": {
      "$ref": "schema-common.json#/$defs/status"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "$ref": "schema-common.json#/$defs/provenance"
          },
          "critical": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
