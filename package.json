{
  "name": "bifurcation-engine",
  "private": true,
  "version": "93",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "start": "if [ \"$ENABLE_PROJECT_MODE\" = \"true\" ]; then test -n \"$APP_PASSWORD\" && test \"$ENABLE_APP_AUTH\" != \"false\" && test -n \"$SESSION_SECRET\" && test -n \"$DATABASE_URL\" || { echo \"Project Mode requires APP_PASSWORD, ENABLE_APP_AUTH, SESSION_SECRET and DATABASE_URL\" >&2; exit 1; }; fi; if [ -n \"$DATABASE_URL\" ]; then npm run db:migrate || exit $?; fi; exec node dist-server/server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:copy": "node scripts/lint-copy.mjs",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "architecture:map": "node scripts/architectureGenerateModuleMap.mjs",
    "architecture:check": "node scripts/architectureCheckBoundaries.mjs",
    "architecture:impact": "node scripts/architectureChangeImpact.mjs",
    "verify:change": "node scripts/architectureVerifyChange.mjs",
    "verify:connections": "tsx scripts/verify-connections.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "patch:pack": "node scripts/pack-simple.mjs",
    "eval:golden": "tsx scripts/golden-eval.mjs --fake",
    "build:server": "tsc -p tsconfig.server.json",
    "monitor:connections": "tsx scripts/monitor-connections.mjs",
    "e01:harness": "node scripts/e01-harness.mjs",
    "evidence:collect": "node scripts/evidence-collect.mjs",
    "gate:eval": "node scripts/gate-eval.mjs",
    "ops:backup-check": "tsx scripts/backup-restore-check.mjs",
    "test:core": "node --import tsx --test --test-timeout=60000 tests/core.test.mjs",
    "test:models": "node --import tsx --test --test-timeout=60000 tests/models.test.mjs",
    "test:security": "node --import tsx --test --test-timeout=60000 tests/security.test.mjs",
    "test:files": "node --import tsx --test --test-timeout=60000 tests/files.test.mjs",
    "test:workspace": "node --import tsx --test --test-timeout=60000 tests/workspace.test.mjs",
    "test:database": "node --import tsx --test --test-timeout=60000 tests/database.test.mjs",
    "test:integrations": "node --import tsx --test --test-timeout=60000 tests/integrations.test.mjs",
    "test:project": "node --import tsx --test --test-timeout=60000 tests/project-mode.test.mjs",
    "test:gates": "node --import tsx --test --test-timeout=60000 tests/gates.test.mjs",
    "test:pipeline": "node --import tsx --test --test-timeout=300000 tests/pipeline.test.mjs",
    "test:web": "node --import tsx --test --test-timeout=60000 tests/web-and-epistemics.test.mjs",
    "test:turn": "node --import tsx --test --test-timeout=60000 tests/conversation-turn.test.mjs",
    "test:regression": "node --import tsx --test --test-timeout=60000 tests/regression.test.mjs",
    "test": "npm run test:core && npm run test:models && npm run test:security && npm run test:files && npm run test:workspace && npm run test:database && npm run test:integrations && npm run test:project && npm run test:gates && npm run test:pipeline && npm run test:web && npm run test:turn && npm run test:regression",
    "test:live": "RUN_LIVE_TESTS=true node --import tsx --test --test-timeout=120000 --test-concurrency=1 tests/database.test.mjs tests/integrations.test.mjs tests/project-mode.test.mjs tests/gates.test.mjs",
    "test:database:live": "RUN_LIVE_TESTS=true node --import tsx --test --test-timeout=120000 --test-concurrency=1 tests/database.test.mjs",
    "test:bx06:api": "RUN_BX06_API=true node --import tsx --test --test-timeout=120000 --test-concurrency=1 tests/project-mode.test.mjs",
    "test:ui": "node --import tsx tests/ui-check.mjs",
    "check": "node scripts/check-version.mjs && node --test tests/architecture-context.test.mjs && npm run test:context-benchmark && npm run test:task-context && npm run test:impact-lineage && npm run test:verification-plan && npm run test:real-task-benchmark && npm run test:intent-contract && npm run test:context-refresh-profile && npm run test:context-completeness && npm run check:docs && npm run lint:copy && npm run typecheck && npm run test:core && npm run test:models && npm run test:security && npm run test:files && npm run test:workspace && npm run test:database && npm run test:integrations && npm run test:project && npm run test:gates && npm run test:pipeline && npm run test:web && npm run test:turn && npm run test:regression && npm run test:app-builder && npm run test:project-diagnostics",
    "docs:generate": "node scripts/docsGenerateInventories.mjs && node scripts/architectureGenerateModuleMap.mjs",
    "docs:check": "node scripts/docsCheckInventories.mjs && npm run check:docs",
    "acceptance:report": "node scripts/acceptanceReport.mjs",
    "context:plan": "node scripts/architectureContextPlan.mjs",
    "context:baseline": "node scripts/architectureContextBaseline.mjs",
    "benchmark:context": "node scripts/contextBenchmark.mjs",
    "test:context-benchmark": "node --test tests/context-benchmark.test.mjs",
    "context:task": "node scripts/architectureTaskContextPlan.mjs",
    "test:task-context": "node --test tests/task-context.test.mjs",
    "impact:lineage": "node scripts/architectureImpactLineage.mjs",
    "test:impact-lineage": "node --test tests/impact-lineage.test.mjs",
    "verification:plan": "node scripts/verificationPlanner.mjs",
    "test:verification-plan": "node --test tests/verification-planner.test.mjs",
    "benchmark:real-tasks": "node scripts/realTaskBenchmark.mjs",
    "test:real-task-benchmark": "node --test tests/real-task-benchmark.test.mjs",
    "intent:contract": "node scripts/intentContract.mjs",
    "test:intent-contract": "node --test tests/intent-contract.test.mjs",
    "context:refresh-profile": "node scripts/contextRefreshProfile.mjs",
    "test:context-refresh-profile": "node --test tests/context-refresh-profile.test.mjs",
    "context:completeness": "node scripts/contextCompletenessGuard.mjs",
    "test:context-completeness": "node --test tests/context-completeness-guard.test.mjs",
    "test:project-diagnostics": "node --import tsx --test tests/project-diagnostics-p92.test.mjs tests/ci-diagnostics-chain.test.mjs tests/app-builder-goal.test.mjs tests/content-disposition-p93.test.mjs tests/app-builder-contracts.test.mjs",
    "test:app-builder": "node --import tsx --test tests/app-builder-contracts.test.mjs tests/app-builder-engine-p93-2a.test.mjs tests/app-builder-validators-p93-2b.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "pdfkit": "^0.20.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "unpdf": "^1.8.1",
    "vite": "^8.3.0",
    "zod": "^3.24.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
