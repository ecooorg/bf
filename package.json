{
  "name": "bifurcation-engine",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "start": "if [ \"$ENABLE_PROJECT_MODE\" = \"true\" ]; then test -n \"$APP_PASSWORD\" && test \"$ENABLE_APP_AUTH\" != \"false\" && test -n \"$SESSION_SECRET\" && test -n \"$DATABASE_URL\" || { echo \"Project Mode requires APP_PASSWORD, ENABLE_APP_AUTH, SESSION_SECRET and DATABASE_URL\" >&2; exit 1; }; fi; if [ -n \"$DATABASE_URL\" ]; then npm run db:migrate || exit $?; fi; node dist-server/server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:copy": "node scripts/lint-copy.mjs",
    "typecheck": "tsc --noEmit",
    "test:merge": "tsx tests/driveMerge.test.mjs",
    "test:security": "tsx tests/security.test.mjs",
    "test:core": "tsx tests/core.mjs",
    "test:reasoning": "tsx tests/reasoning.test.mjs",
    "test:export": "tsx tests/export-name.test.mjs",
    "test:sync": "tsx tests/driveSync.test.mjs",
    "test:files": "tsx tests/files.test.mjs",
    "test:drivedocs": "tsx tests/driveDocs.test.mjs",
    "check": "node scripts/check-version.mjs && npm run check:docs && npm run test:version && npm run lint:copy && npm run typecheck && npm run test:merge && npm run test:security && npm run test:core && npm run test:reasoning && npm run test:export && npm run test:sync && npm run test:files && npm run test:drivedocs && npm run test:database && npm run test:contracts && npm run test:model-layer && npm run test:conformance && npm run test:connections && npm run test:state && npm run test:bx06 && npm run test:library && npm run test:package-c && npm run test:virtual",
    "test:virtual": "bash tests/run.sh",
    "test:ui": "node --import tsx tests/ui-check.mjs",
    "test:version": "node tests/version-check.test.mjs",
    "test:library": "tsx tests/libraryExport.test.mjs",
    "test:package-c": "node tests/package-c.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:connections": "tsx scripts/verify-connections.mjs",
    "test:connections": "node --import tsx --test tests/connections.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test:database": "node tests/database-contract.test.mjs",
    "test:model-layer": "node --import tsx --test tests/model-layer.test.mjs",
    "test:conformance": "node --import tsx --test tests/conformance.test.mjs",
    "test:state": "node --import tsx --test tests/state-pipeline.test.mjs",
    "test:contracts": "node --import tsx --test tests/contracts.test.mjs",
    "test:database:live": "node --import tsx --test tests/database-live.test.mjs tests/artifacts-live.test.mjs tests/state-pipeline-live.test.mjs",
    "test:bx06": "node --test tests/bx06.test.mjs",
    "test:bx06:api": "node --import tsx --test tests/bx06-api.test.mjs",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "pdfkit": "^0.20.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "unpdf": "^1.8.1",
    "vite": "^8.3.0",
    "zod": "^3.24.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
