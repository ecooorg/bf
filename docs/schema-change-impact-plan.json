{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biforge.local/schemas/schema-change-impact-plan.json",
  "title": "Change/Impact Plan",
  "description": "Declared scope of change, expected impact surface, and risks before implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "summary",
    "status",
    "impacts"
  ],
  "properties": {
    "meta": {
      "$ref": "schema-common.json#/$defs/schemaMeta"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "schema-common.json#/$defs/status"
    },
    "impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "schema-common.json#/$defs/status"
          },
          "relatedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
