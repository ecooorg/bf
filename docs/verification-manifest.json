{
  "schemaVersion": 1,
  "kind": "verification-manifest",
  "profiles": {
    "check": "Local and CI check chain without database migrate or production build",
    "ci": "Hosted CI: check chain plus db-migrate (when DAG_TEST_DATABASE_URL is set) and production build"
  },
  "defaults": {
    "timeoutMs": 600000,
    "memoryLimitMb": 4096,
    "safeToRun": true,
    "parallelGroup": null,
    "critical": false,
    "needs": [],
    "requiresEnv": [],
    "env": {},
    "phase": "check"
  },
  "rules": {
    "concurrency": "DAG_CONCURRENCY or --concurrency, default 1; checks run together only when both declare the same non-null parallelGroup",
    "unsafe": "safeToRun=false runs only when DAG_ALLOW_UNSAFE=true, else SKIPPED_BY_POLICY",
    "timeoutScale": "DAG_TIMEOUT_SCALE can only raise timeouts (values below 1 are ignored)",
    "env": "children never inherit DATABASE_URL or PGSSLMODE; a check declares them in env, values starting with $ are read from the runner environment"
  },
  "checks": [
    {
      "id": "version-consistency",
      "argv": [
        "node",
        "scripts/check-version.mjs"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 60000,
      "parallelGroup": "static"
    },
    {
      "id": "docs-integrity",
      "argv": [
        "npm",
        "run",
        "docs:integrity"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 60000,
      "parallelGroup": "static",
      "critical": true,
      "phase": "critical",
      "expectOutput": [
        "docs:integrity PASS"
      ]
    },
    {
      "id": "lint:copy",
      "argv": [
        "npm",
        "run",
        "lint:copy"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 120000,
      "parallelGroup": "static"
    },
    {
      "id": "critical-router-selection",
      "argv": [
        "node",
        "--import",
        "tsx",
        "--test",
        "--test-timeout=15000",
        "--test-name-pattern",
        "router: deterministic selection with recorded rejections",
        "tests/providers-models.test.mjs"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 20000,
      "critical": true,
      "phase": "critical",
      "sourceFile": "tests/providers-models.test.mjs",
      "targetPattern": "router: deterministic selection with recorded rejections",
      "expectOutput": [
        "router: deterministic selection with recorded rejections"
      ],
      "nodeTestTimeoutMs": 15000
    },
    {
      "id": "critical-router-policy-call-limit",
      "argv": [
        "node",
        "--import",
        "tsx",
        "--test",
        "--test-timeout=15000",
        "tests/providers-router-policy.test.mjs"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 20000,
      "critical": true,
      "phase": "critical",
      "sourceFile": "tests/providers-router-policy.test.mjs",
      "expectOutput": [
        "router: invalid request stops before fallback",
        "router: policy rejection stops before fallback",
        "router: call limit stops after maxCalls"
      ],
      "nodeTestTimeoutMs": 15000
    },
    {
      "id": "critical-gemini-timeout",
      "argv": [
        "node",
        "--import",
        "tsx",
        "--test",
        "--test-timeout=15000",
        "--test-name-pattern",
        "conformance gemini: timeout",
        "tests/providers-models.test.mjs"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 20000,
      "critical": true,
      "phase": "critical",
      "sourceFile": "tests/providers-models.test.mjs",
      "targetPattern": "conformance gemini: timeout",
      "expectOutput": [
        "conformance gemini: timeout"
      ],
      "nodeTestTimeoutMs": 15000
    },
    {
      "id": "critical-app-builder-recovery",
      "argv": [
        "node",
        "--import",
        "tsx",
        "--test",
        "--test-timeout=15000",
        "--test-name-pattern",
        "recovery: interrupted on unit three, resume reuses completed units without regenerating|cancellation stops before the next unit and reports cancelled",
        "tests/project-builder-recovery.test.mjs"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 20000,
      "critical": true,
      "phase": "critical",
      "sourceFile": "tests/project-builder-recovery.test.mjs",
      "targetPattern": "recovery: interrupted on unit three, resume reuses completed units without regenerating|cancellation stops before the next unit and reports cancelled",
      "expectOutput": [
        "recovery: interrupted on unit three, resume reuses completed units without regenerating",
        "cancellation stops before the next unit and reports cancelled"
      ],
      "nodeTestTimeoutMs": 15000
    },
    {
      "id": "typecheck",
      "argv": [
        "npm",
        "run",
        "typecheck"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "needs": [
        "critical-router-selection",
        "critical-router-policy-call-limit",
        "critical-gemini-timeout"
      ],
      "timeoutMs": 120000,
      "critical": true,
      "phase": "minimum-suite",
      "parallelGroup": "static"
    },
    {
      "id": "architecture:check",
      "argv": [
        "npm",
        "run",
        "architecture:check"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 60000,
      "parallelGroup": "static"
    },
    {
      "id": "test:core",
      "argv": [
        "npm",
        "run",
        "test:core"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "needs": [
        "critical-router-selection",
        "critical-router-policy-call-limit",
        "critical-gemini-timeout"
      ],
      "timeoutMs": 75000,
      "critical": true,
      "phase": "minimum-suite"
    },
    {
      "id": "test:models",
      "argv": [
        "npm",
        "run",
        "test:models"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "needs": [
        "critical-router-selection",
        "critical-router-policy-call-limit",
        "critical-gemini-timeout"
      ],
      "timeoutMs": 75000,
      "critical": true,
      "phase": "minimum-suite"
    },
    {
      "id": "test:app-builder",
      "argv": [
        "npm",
        "run",
        "test:app-builder"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "needs": [
        "critical-router-selection",
        "critical-router-policy-call-limit",
        "critical-gemini-timeout",
        "critical-app-builder-recovery"
      ],
      "timeoutMs": 150000,
      "critical": true,
      "phase": "minimum-suite"
    },
    {
      "id": "test:project",
      "argv": [
        "npm",
        "run",
        "test:project"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "needs": [
        "critical-router-selection",
        "critical-router-policy-call-limit",
        "critical-gemini-timeout"
      ],
      "timeoutMs": 120000,
      "critical": true,
      "phase": "minimum-suite"
    },
    {
      "id": "test:security",
      "argv": [
        "npm",
        "run",
        "test:security"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 600000
    },
    {
      "id": "test:project-diagnostics",
      "argv": [
        "npm",
        "run",
        "test:project-diagnostics"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 600000
    },
    {
      "id": "db-migrate",
      "argv": [
        "npm",
        "run",
        "db:migrate"
      ],
      "profiles": [
        "ci"
      ],
      "timeoutMs": 300000,
      "requiresEnv": [
        "DAG_TEST_DATABASE_URL"
      ],
      "env": {
        "DATABASE_URL": "$DAG_TEST_DATABASE_URL",
        "PGSSLMODE": "disable"
      },
      "safeToRun": false
    },
    {
      "id": "build",
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "profiles": [
        "ci"
      ],
      "timeoutMs": 480000
    },
    {
      "id": "workflow-action-pins",
      "argv": [
        "node",
        "--test",
        "tests/governance-workflow-pins.test.mjs"
      ],
      "profiles": [
        "check",
        "ci"
      ],
      "timeoutMs": 60000,
      "parallelGroup": "static"
    }
  ]
}
